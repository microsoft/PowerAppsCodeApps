node_modules
dist
dist-ssr
*.local
package-lock.json

# Power Apps code app config — environment/app specific, generated by `power-apps init`.
# Do not commit: it contains your appId, environmentId, and connection references.
power.config.json

# Power Apps generated connector schema — environment-specific (embeds your environment ID / API
# hub host). Regenerated by `power-apps add-data-source`. Do not commit.
.power/

# Auto-generated connector service + models — created by `power-apps add-data-source`.
# Regenerated per environment; users generate their own. Do not commit.
src/generated/

# Local npm registry override (machine-specific workaround, not part of the sample)
.npmrc

